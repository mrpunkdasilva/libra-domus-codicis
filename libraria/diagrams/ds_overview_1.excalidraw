    },
    {
      "id": "dhXRskpWd8qcILulSsYof",
      "type": "text",
      "x": 5766.252335205675,
      "y": -344.2163677664446,
      "width": 640.4594116210938,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4A",
      "roundness": null,
      "seed": 1195072521,
      "version": 620,
      "versionNonce": 1225869769,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764907778471,
      "link": null,
      "locked": false,
      "text": "Poderia seguir depois dos 4P's estes passos da documentação\n\n1. Casos de uso\n2. Épicas\n3. Histórias de usuario\n4. MVP Trunk\n\nNo caso, isso poderia ser feito em 1 Sprint \ne a ideia não é ser nada complexo, além de que \npodemos adicionar ou retirar partes de Épicas, por exemplo, caso \nache necessário no decorrer do projeto",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Poderia seguir depois dos 4P's estes passos da documentação\n\n1. Casos de uso\n2. Épicas\n3. Histórias de usuario\n4. MVP Trunk\n\nNo caso, isso poderia ser feito em 1 Sprint \ne a ideia não é ser nada complexo, além de que \npodemos adicionar ou retirar partes de Épicas, por exemplo, caso \nache necessário no decorrer do projeto",
      "autoResize": true,
      "lineHeight": 1.25
    },
