    },
    {
      "id": "AB5I0TuNrprxwTs3pTKq4",
      "type": "text",
      "x": 4670.544166758507,
      "y": 4266.561159649565,
      "width": 394.45965576171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b54z",
      "roundness": null,
      "seed": 250705481,
      "version": 1217,
      "versionNonce": 646241723,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765278444638,
      "link": null,
      "locked": false,
      "text": "PRÉ-CONDIÇÕES:\n- Cliente tem uma conta ativa e logado\n- Tem que ter saldo\n- Tem que ter no carrinho algum produto",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
