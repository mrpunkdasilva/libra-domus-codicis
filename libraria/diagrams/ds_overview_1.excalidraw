      "text": "DEPOIS VAMOS PARA",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEPOIS VAMOS PARA",
      "autoResize": true,
