      "versionNonce": 1361728233,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764904559446,
      "link": null,
      "locked": false,
      "text": "Descreve o conjunto de atividades e práticas usadas \npara fazer o software",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Descreve o conjunto de atividades e práticas usadas \npara fazer o software",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IQh6zaeWWEJNJt0w3aiAq",
      "type": "text",
      "x": 4178.889402600281,
      "y": -155.7118895386697,
      "width": 816.5606689453125,
      "height": 156.60227931797385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "NhZcjgIW0GU4IHUNp3BZy"
      ],
      "frameId": null,
      "index": "b3tx",
      "roundness": null,
      "seed": 1272620809,
      "version": 1012,
      "versionNonce": 1009962729,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764969760599,
      "link": null,
      "locked": false,
      "text": "Metodologia: Scrum, Kanban\n\nAtividades: Planejamento, analise, design, codificação, testes e implantação\n\nFerramentas e técnicas: Versionamento, frameworks de teste, ferramentas de desenvolvimento\n\nPadrões: regras para manter uma boa qualidade",
      "fontSize": 17.897403350625584,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Metodologia: Scrum, Kanban\n\nAtividades: Planejamento, analise, design, codificação, testes e implantação\n\nFerramentas e técnicas: Versionamento, frameworks de teste, ferramentas de desenvolvimento\n\nPadrões: regras para manter uma boa qualidade",
      "autoResize": true,
      "lineHeight": 1.25
    },
