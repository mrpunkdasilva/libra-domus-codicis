      "type": "text",
      "x": 2740.379082693412,
      "y": 3922.2174700666606,
      "width": 736.9793701171875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
