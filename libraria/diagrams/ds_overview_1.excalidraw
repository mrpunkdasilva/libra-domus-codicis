      "text": "Foco no software em si, seus requisitos e evolução:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Foco no software em si, seus requisitos e evolução:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "A3nYWVEEWcmJN2pQ2auj-",
