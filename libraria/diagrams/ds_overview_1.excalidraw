      "x": 4187.677668996853,
      "y": -429.8959493217752,
      "width": 633.3618774414062,
      "height": 156.60227931797385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
